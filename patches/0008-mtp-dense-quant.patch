diff --git a/zig/src/families/flashnext/cuda_mtp_quant.zig b/zig/src/families/flashnext/cuda_mtp_quant.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_mtp_quant.zig
@@ -0,0 +1,355 @@
+//! Load-time quantization of BF16 MTP proposal-layer projections (TF_FLASHNEXT_MTP_QUANT).
+//! Proposal-only: the main verifier model and its weights remain completely untouched.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const projection = @import("cuda_projection.zig");
+const projections = @import("cuda_projection_load.zig");
+const affine = @import("cuda_draft_affine.zig");
+const environment = @import("sys").environment;
+
+const setting_name = "TF_FLASHNEXT_MTP_QUANT";
+
+/// How BF16 MTP proposal projections are held; the order matches environment.zig's accepted words.
+pub const Mode = enum(u2) { bf16 = 0, mxfp8 = 1, affine4 = 2 };
+
+/// Default for unset/blank TF_FLASHNEXT_MTP_QUANT.
+pub const default_mode: Mode = .mxfp8;
+
+pub fn parse(raw: ?[]const u8) !Mode {
+    return @enumFromInt(try environment.value(u2, setting_name, raw, @intFromEnum(default_mode)));
+}
+
+pub fn mode() !Mode {
+    return @enumFromInt(try environment.read(u2, setting_name, @intFromEnum(default_mode)));
+}
+
+fn readBf16(bytes: []const u8, i: usize) f32 {
+    return @bitCast(@as(u32, std.mem.readInt(u16, bytes[i * 2 ..][0..2], .little)) << 16);
+}
+
+/// Round-to-nearest-even finite f32 to IEEE/OCP FP8 E4M3FN (max finite 448.0, 0x7e).
+pub fn f32ToE4m3fn(v: f32) u8 {
+    const bits: u32 = @bitCast(v);
+    const sign: u8 = @intCast((bits >> 31) << 7);
+    const abs_v = @abs(v);
+    if (abs_v == 0) return 0;
+    if (abs_v >= 448.0) return sign | 0x7e;
+    // Subnormal E4M3FN range: < 2^-6 (0.015625), step = 2^-9.
+    if (abs_v < 0.015625) {
+        const scaled = abs_v * 512.0;
+        const lo = @floor(scaled);
+        const integer: u8 = @intFromFloat(lo);
+        const frac = scaled - lo;
+        const rounded = integer + @intFromBool(frac > 0.5 or (frac == 0.5 and (integer & 1) == 1));
+        if (rounded == 0) return 0;
+        if (rounded >= 8) return sign | 0x08; // smallest normal 2^-6
+        return sign | rounded;
+    }
+    const abits: u32 = bits & 0x7fff_ffff;
+    const e32: i32 = @as(i32, @intCast(abits >> 23)) - 127;
+    const m32: u32 = abits & 0x007f_ffff;
+    const rem: u32 = m32 & 0x000f_ffff;
+    var m3: u32 = (m32 >> 20) + @intFromBool(rem > 0x0008_0000 or (rem == 0x0008_0000 and ((m32 >> 20) & 1) == 1));
+    var e4: i32 = e32 + 7;
+    if (m3 == 8) {
+        m3 = 0;
+        e4 += 1;
+    }
+    if (e4 > 15 or (e4 == 15 and m3 > 6)) return sign | 0x7e;
+    return sign | (@as(u8, @intCast(e4)) << 3) | @as(u8, @intCast(m3));
+}
+
+/// Quantize one BF16 row of `k` elements (multiple of 32) into OCP MXFP8 (E4M3FN codes + UE8M0 group-32 scales).
+pub fn mxfp8Row(input: []const u8, codes: []u8, scales: []u8) !void {
+    const k = input.len / 2;
+    if (k == 0 or k % 32 != 0 or input.len != k * 2 or codes.len != k or scales.len != k / 32)
+        return error.UnexpectedTensor;
+    for (0..k / 32) |g| {
+        const at = g * 32;
+        var amax: f32 = 0;
+        for (0..32) |i| {
+            const v = readBf16(input, at + i);
+            if (!std.math.isFinite(v)) return error.UnexpectedTensor;
+            amax = @max(amax, @abs(v));
+        }
+        if (amax == 0) {
+            scales[g] = 127;
+            @memset(codes[at..][0..32], 0);
+            continue;
+        }
+        // Choose smallest power-of-two scale 2^e >= amax / 448.0 so max |v| / 2^e <= 448.0.
+        const raw_e: i32 = @intFromFloat(@ceil(@log2(@as(f64, amax) / 448.0)));
+        const exp: i32 = std.math.clamp(raw_e, -127, 127);
+        scales[g] = @intCast(exp + 127);
+        const inv_scale: f32 = @floatCast(@exp2(@as(f64, @floatFromInt(-exp))));
+        for (0..32) |i| {
+            codes[at + i] = f32ToE4m3fn(readBf16(input, at + i) * inv_scale);
+        }
+    }
+}
+
+fn quantizeMxfp8(a: std.mem.Allocator, d: *const cuda.Driver, bytes: []const u8, n: usize, k: usize) !wt.Q4 {
+    const count = try std.math.mul(usize, n, k);
+    if (bytes.len != try std.math.mul(usize, count, 2) or k % 64 != 0) return error.UnexpectedTensor;
+    const codes = try a.alloc(u8, count);
+    defer a.free(codes);
+    const scales = try a.alloc(u8, count / 32);
+    defer a.free(scales);
+    const Work = struct {
+        bytes: []const u8,
+        codes: []u8,
+        scales: []u8,
+        k: usize,
+        lo: usize,
+        hi: usize,
+        failed: ?anyerror = null,
+        fn run(w: *@This()) void {
+            for (w.lo..w.hi) |i| {
+                mxfp8Row(
+                    w.bytes[i * w.k * 2 ..][0 .. w.k * 2],
+                    w.codes[i * w.k ..][0..w.k],
+                    w.scales[i * (w.k / 32) ..][0 .. w.k / 32],
+                ) catch |err| {
+                    w.failed = err;
+                    return;
+                };
+            }
+        }
+    };
+    const max_t: usize = 16;
+    const cpus = std.Thread.getCpuCount() catch 8;
+    const t_n = @max(1, @min(max_t, cpus, n));
+    const per = (n + t_n - 1) / t_n;
+    var works: [max_t]Work = undefined;
+    var handles: [max_t]?std.Thread = @splat(null);
+    for (0..t_n) |t| {
+        const lo = @min(n, t * per);
+        const hi = @min(n, (t + 1) * per);
+        works[t] = .{ .bytes = bytes, .codes = codes, .scales = scales, .k = k, .lo = lo, .hi = hi };
+        handles[t] = if (t + 1 < t_n) (std.Thread.spawn(.{}, Work.run, .{&works[t]}) catch blk: {
+            works[t].run();
+            break :blk null;
+        }) else blk: {
+            works[t].run();
+            break :blk null;
+        };
+    }
+    for (handles[0..t_n]) |h| if (h) |th| th.join();
+    for (works[0..t_n]) |w| if (w.failed) |err| return err;
+    return projection.mxfp8(
+        a,
+        d,
+        .{ .dtype = .f8_e4m3, .rank = 2, .shape = .{ n, k, 1, 1, 1 }, .bytes = codes },
+        .{ .dtype = .u8, .rank = 2, .shape = .{ n, k / 32, 1, 1, 1 }, .bytes = scales },
+    );
+}
+
+const AffinePlanes = struct {
+    words: []u8,
+    scales: []u8,
+    biases: []u8,
+
+    fn free(self: *AffinePlanes, a: std.mem.Allocator) void {
+        a.free(self.words);
+        a.free(self.scales);
+        a.free(self.biases);
+    }
+};
+
+fn quantizeAffinePlanes(a: std.mem.Allocator, bytes: []const u8, n: usize, k: usize) !AffinePlanes {
+    const count = try std.math.mul(usize, n, k);
+    if (bytes.len != try std.math.mul(usize, count, 2) or k % 32 != 0) return error.UnexpectedTensor;
+    const words = try a.alloc(u8, count / 2);
+    errdefer a.free(words);
+    const scales = try a.alloc(u8, count / 16);
+    errdefer a.free(scales);
+    const biases = try a.alloc(u8, count / 16);
+    errdefer a.free(biases);
+    const Work = struct {
+        bytes: []const u8,
+        words: []u8,
+        scales: []u8,
+        biases: []u8,
+        k: usize,
+        lo: usize,
+        hi: usize,
+        failed: ?anyerror = null,
+        fn run(w: *@This()) void {
+            for (w.lo..w.hi) |i| {
+                affine.row(
+                    w.bytes[i * w.k * 2 ..][0 .. w.k * 2],
+                    w.words[i * (w.k / 2) ..][0 .. w.k / 2],
+                    w.scales[i * (w.k / 16) ..][0 .. w.k / 16],
+                    w.biases[i * (w.k / 16) ..][0 .. w.k / 16],
+                ) catch |err| {
+                    w.failed = err;
+                    return;
+                };
+            }
+        }
+    };
+    const max_t: usize = 16;
+    const cpus = std.Thread.getCpuCount() catch 8;
+    const t_n = @max(1, @min(max_t, cpus, n));
+    const per = (n + t_n - 1) / t_n;
+    var works: [max_t]Work = undefined;
+    var handles: [max_t]?std.Thread = @splat(null);
+    for (0..t_n) |t| {
+        const lo = @min(n, t * per);
+        const hi = @min(n, (t + 1) * per);
+        works[t] = .{ .bytes = bytes, .words = words, .scales = scales, .biases = biases, .k = k, .lo = lo, .hi = hi };
+        handles[t] = if (t + 1 < t_n) (std.Thread.spawn(.{}, Work.run, .{&works[t]}) catch blk: {
+            works[t].run();
+            break :blk null;
+        }) else blk: {
+            works[t].run();
+            break :blk null;
+        };
+    }
+    for (handles[0..t_n]) |h| if (h) |th| th.join();
+    for (works[0..t_n]) |w| if (w.failed) |err| return err;
+    return .{ .words = words, .scales = scales, .biases = biases };
+}
+
+pub fn quantizeProjection(a: std.mem.Allocator, d: *cuda.Driver, bytes: []const u8, n: usize, k: usize, role: Mode) !wt.Q4 {
+    return switch (role) {
+        .bf16 => projection.dense(a, d, .{ .dtype = .bf16, .rank = 2, .shape = .{ n, k, 1, 1, 1 }, .bytes = bytes }),
+        .mxfp8 => quantizeMxfp8(a, d, bytes, n, k),
+        .affine4 => blk: {
+            var planes = try quantizeAffinePlanes(a, bytes, n, k);
+            defer planes.free(a);
+            break :blk wt.uploadQ4(a, d, planes.words, planes.scales, planes.biases, n, k / 8);
+        },
+    };
+}
+
+pub fn loadProjection(a: std.mem.Allocator, d: *cuda.Driver, store: *wt.Store, prefix: []const u8, n: usize, k: usize, role: Mode) !wt.Q4 {
+    if (role == .bf16) return projections.load(a, d, store, prefix, n, k);
+    var buf: [512]u8 = undefined;
+    const t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.weight", .{prefix}));
+    if (t.dtype != .bf16) return projections.load(a, d, store, prefix, n, k);
+    if (!t.is(.bf16, &.{ n, k })) return error.UnexpectedTensor;
+    const bytes = try a.dupe(u8, t.bytes);
+    defer a.free(bytes);
+    return quantizeProjection(a, d, bytes, n, k, role);
+}
+
+pub fn loadStitchedProjection(a: std.mem.Allocator, d: *cuda.Driver, store: *wt.Store, prefix: []const u8, names: []const []const u8, n: usize, k: usize, role: Mode) !wt.Q4 {
+    if (role == .bf16 or names.len == 0) return projections.loadStitched(a, d, store, prefix, names, n, k);
+    var buf: [512]u8 = undefined;
+    const first = try store.tensor(try std.fmt.bufPrint(&buf, "{s}{s}.weight", .{ prefix, names[0] }));
+    if (first.dtype != .bf16) return projections.loadStitched(a, d, store, prefix, names, n, k);
+    const bytes = try a.alloc(u8, try std.math.mul(usize, try std.math.mul(usize, n, k), 2));
+    defer a.free(bytes);
+    var at: usize = 0;
+    for (names) |part_name| {
+        const t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}{s}.weight", .{ prefix, part_name }));
+        if (t.dtype != .bf16 or t.rank != 2 or t.dim(1) != k or t.bytes.len != t.dim(0) * k * 2 or t.bytes.len > bytes.len - at)
+            return error.UnexpectedTensor;
+        @memcpy(bytes[at..][0..t.bytes.len], t.bytes);
+        at += t.bytes.len;
+    }
+    if (at != bytes.len) return error.UnexpectedTensor;
+    return quantizeProjection(a, d, bytes, n, k, role);
+}
+
+/// Load an MTP hyper-connection block, quantizing BF16 down/up matrices according to `role`.
+pub fn loadHc(a: std.mem.Allocator, d: *cuda.Driver, store: *wt.Store, prefix: []const u8, inject: bool, role: Mode) !wt.HcW {
+    if (role == .bf16) return wt.loadHc(a, d, store, prefix, inject);
+    var buf: [200]u8 = undefined;
+    const down_t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.input_mix_weight_down.weight", .{prefix}));
+    if (down_t.dtype != .bf16) return wt.loadHc(a, d, store, prefix, inject);
+    const n = wt.low + if (inject) wt.streams else @as(usize, 0);
+    const down_bytes = try a.alloc(u8, n * wt.wide * 2);
+    defer a.free(down_bytes);
+    if (!down_t.is(.bf16, &.{ wt.low, wt.wide }) or down_t.bytes.len != wt.low * wt.wide * 2) return error.UnexpectedTensor;
+    @memcpy(down_bytes[0..down_t.bytes.len], down_t.bytes);
+    if (inject) {
+        const inj = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.block_inject_weight.weight", .{prefix}));
+        if (!inj.is(.bf16, &.{ wt.streams, wt.wide }) or inj.bytes.len != wt.streams * wt.wide * 2) return error.UnexpectedTensor;
+        @memcpy(down_bytes[wt.low * wt.wide * 2 ..], inj.bytes);
+    }
+    const up_t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.input_mix_weight_up.weight", .{prefix}));
+    if (!up_t.is(.bf16, &.{ wt.wide, wt.low }) or up_t.bytes.len != wt.wide * wt.low * 2) return error.UnexpectedTensor;
+    const up_bytes = try a.dupe(u8, up_t.bytes);
+    defer a.free(up_bytes);
+    const gamma = try store.normScale(a, try store.tensor(try std.fmt.bufPrint(&buf, "{s}.hc_norm.weight", .{prefix})));
+    defer a.free(gamma);
+    if (gamma.len != wt.wide) return error.UnexpectedTensor;
+
+    var dq = switch (role) {
+        .bf16 => unreachable,
+        .mxfp8 => try quantizeMxfp8(a, d, down_bytes, n, wt.wide),
+        .affine4 => blk: {
+            var dp = try quantizeAffinePlanes(a, down_bytes, n, wt.wide);
+            defer dp.free(a);
+            break :blk try wt.uploadTiled(a, d, dp.words, dp.scales, dp.biases, n, wt.wide / 8);
+        },
+    };
+    errdefer dq.free();
+    var uq = switch (role) {
+        .bf16 => unreachable,
+        .mxfp8 => try quantizeMxfp8(a, d, up_bytes, wt.wide, wt.low),
+        .affine4 => blk: {
+            var up_p = try quantizeAffinePlanes(a, up_bytes, wt.wide, wt.low);
+            defer up_p.free(a);
+            break :blk try wt.uploadTiled(a, d, up_p.words, up_p.scales, up_p.biases, wt.wide, wt.low / 8);
+        },
+    };
+    errdefer uq.free();
+    const scale = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(gamma));
+    return .{ .scale = scale, .down = dq, .up = uq, .n_down = n, .has_inj = @intFromBool(inject) };
+}
+
+fn decodeE4m3fn(code: u8) f64 {
+    const sign: f64 = if ((code & 0x80) != 0) -1.0 else 1.0;
+    const exp: i32 = @intCast((code >> 3) & 0x0f);
+    const mant: u8 = code & 0x07;
+    if (exp == 0) return sign * @as(f64, @floatFromInt(mant)) * std.math.pow(f64, 2.0, -9.0);
+    return sign * (1.0 + @as(f64, @floatFromInt(mant)) / 8.0) * std.math.pow(f64, 2.0, @as(f64, @floatFromInt(exp - 7)));
+}
+
+test "TF_FLASHNEXT_MTP_QUANT parses bf16, mxfp8, affine4 and defaults blank/unset" {
+    for ([_]?[]const u8{ null, "", " ", "\t", " \t\r\n" }) |raw| try std.testing.expectEqual(default_mode, try parse(raw));
+    try std.testing.expectEqual(Mode.bf16, try parse("bf16"));
+    try std.testing.expectEqual(Mode.mxfp8, try parse("mxfp8"));
+    try std.testing.expectEqual(Mode.affine4, try parse("affine4"));
+    for ([_][]const u8{ "BF16", "fp8", "int4", "1", "mxfp8 " }) |raw| try std.testing.expectError(error.InvalidEnvironment, parse(raw));
+}
+
+test "E4M3FN encoding handles exact powers, subnormals, saturation, and zero" {
+    try std.testing.expectEqual(@as(u8, 0x00), f32ToE4m3fn(0.0));
+    try std.testing.expectEqual(@as(u8, 0x38), f32ToE4m3fn(1.0));
+    try std.testing.expectEqual(@as(u8, 0xb8), f32ToE4m3fn(-1.0));
+    try std.testing.expectEqual(@as(u8, 0x7e), f32ToE4m3fn(448.0));
+    try std.testing.expectEqual(@as(u8, 0x7e), f32ToE4m3fn(1000.0));
+    try std.testing.expectEqual(@as(u8, 0xfe), f32ToE4m3fn(-1000.0));
+    try std.testing.expectEqual(@as(u8, 0x08), f32ToE4m3fn(0.015625));
+    try std.testing.expectEqual(@as(u8, 0x01), f32ToE4m3fn(1.0 / 512.0));
+}
+
+test "mxfp8Row matches independent FP64 dequantization within E4M3FN rounding tolerance" {
+    var input: [128]u8 = undefined;
+    for (0..64) |i| {
+        const v: f32 = if (i < 32) @sin(@as(f32, @floatFromInt(i)) * 0.41) * 0.08 else 0.0;
+        std.mem.writeInt(u16, input[i * 2 ..][0..2], affine.bf16(v), .little);
+    }
+    var codes: [64]u8 = undefined;
+    var scales: [2]u8 = undefined;
+    try mxfp8Row(&input, &codes, &scales);
+    // Second group is all zeros: unit scale (127) and zero codes.
+    try std.testing.expectEqual(@as(u8, 127), scales[1]);
+    for (codes[32..]) |c| try std.testing.expectEqual(@as(u8, 0), c);
+    // First group: dequantize with UE8M0 scale and verify bounded error.
+    const sc = std.math.pow(f64, 2.0, @as(f64, @floatFromInt(@as(i32, scales[0]) - 127)));
+    for (0..32) |i| {
+        const orig: f64 = readBf16(&input, i);
+        const back = decodeE4m3fn(codes[i]) * sc;
+        const tol = @max(@abs(orig) * 0.065, sc * (1.0 / 512.0));
+        try std.testing.expect(@abs(back - orig) <= tol);
+    }
