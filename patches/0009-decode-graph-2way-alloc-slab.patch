+pub fn allocKvSlab(e: *Engine, seq: *Seq, cap: usize) !void {
+    const a = std.mem.alignForward;
+    const kc_len = if (e.kv == .fp8) cap * e.kv.keyRow() else sizes.kvBytes(cap, e.heads);
